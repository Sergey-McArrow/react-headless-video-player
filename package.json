{
  "name": "react-headless-video-player",
  "version": "0.2.0",
  "description": "Headless, customizable React video player with context to manage single active playback across the page.",
  "keywords": [
    "react",
    "video",
    "player",
    "headless",
    "customizable",
    "media",
    "typescript",
    "nextjs"
  ],
  "license": "MIT",
  "author": "Sergey McArrow <info@mcarrow.online>",
  "homepage": "https://github.com/Sergey-McArrow/react-headless-video-player#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sergey-McArrow/react-headless-video-player.git"
  },
  "bugs": {
    "url": "https://github.com/Sergey-McArrow/react-headless-video-player/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "happy-dom": "^21.0.4",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "playground": "bun run playground/server.ts",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  }
}
